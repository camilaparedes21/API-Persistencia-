{
  "info": {
    "name": "Anti-Social Net (MongoDB) — Comentarios y Tags",
    "description": "Requiere que existan un usuario y un post: pegar sus _id en las variables userId y postId (o correr antes las carpetas de User y Post). Correr las carpetas en orden.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "userId",
      "value": "PEGAR_ID_DE_UN_USUARIO"
    },
    {
      "key": "postId",
      "value": "PEGAR_ID_DE_UN_POST"
    },
    {
      "key": "commentId",
      "value": ""
    },
    {
      "key": "oldCommentId",
      "value": ""
    },
    {
      "key": "tagId",
      "value": ""
    },
    {
      "key": "tagId2",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Comments",
      "item": [
        {
          "name": "Crear comentario → 201",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/posts/{{postId}}/comments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "posts",
                "{{postId}}",
                "comments"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"{{userId}}\",\n  \"content\": \"¡Qué buena foto!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
                  "if (pm.response.code === 201) pm.collectionVariables.set(\"commentId\", pm.response.json()._id);"
                ]
              }
            }
          ]
        },
